BOT_TOKEN=your-telegram-bot-token
SOURCE_CHANNEL_ID=-1001234567890
TARGET_CHANNEL_ID=-1009876543210
TARGET_LINK=https://t.me/your_channel
LOG_LEVEL=INFO

# Optional: Telegram user account bootstrap.
# Use this only if you want a real Telegram account to add/promote the bot in channels.
ACCOUNT_BOOTSTRAP_ENABLED=false
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your-telegram-api-hash
TELEGRAM_USER_PHONE=+380000000000
TELEGRAM_SESSION=telegram_account
BOT_USERNAME=your_bot_username
SOURCE_CHANNEL_REF=@source_channel_username
TARGET_CHANNEL_REF=@target_channel_username

# Optional: read source channel through Telegram account instead of Bot API.
# This allows reading channels where the bot is not admin, but the account is subscribed.
ACCOUNT_SOURCE_ENABLED=false
ACCOUNT_SOURCE_DOWNLOAD_DIR=downloads

# Sending mode:
# manual - only by /send or menu button
# immediate - send after adding new media to queue
# interval - send one queued item every SEND_INTERVAL_MINUTES
# cron - send by SEND_CRON_HOUR/SEND_CRON_MINUTE
SEND_MODE=interval
SEND_INTERVAL_MINUTES=30
SEND_CRON_HOUR=*
SEND_CRON_MINUTE=*/30
